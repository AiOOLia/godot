; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DigitalViewer"
config/description="Cross-platform 3D and geospatial data viewer"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icon.svg"

[autoload]

AppState="*res://scripts/app_state.gd"

[debug]

file_logging/enable_file_logging.pc=false
settings/gdscript/always_track_call_stacks=true

[digital_viewer]

profile="ALL"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/subwindows/embed_subwindows=false
window/handheld/orientation=6
window/dpi/per_monitor_dpi_aware=true

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.059, 0.075, 1)
